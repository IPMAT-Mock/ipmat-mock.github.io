{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPMAT Question v2 (IIMB 60Q, +3/-1)",
  "type": "object",
  "required": ["qid", "section", "topic", "difficulty", "stem", "options", "answer_index"],
  "properties": {
    "qid": {"type": "string", "minLength": 1},
    "section": {"type": "string", "enum": ["QA", "LR", "VARC"]},
    "topic": {"type": "string", "minLength": 1},
    "subtopic": {"type": "string"},
    "difficulty": {"type": "string", "enum": ["Easy", "Medium", "Hard"]},
    "marks": {
      "type": "object",
      "required": ["correct", "wrong", "skipped"],
      "properties": {
        "correct": {"const": 3},
        "wrong": {"const": -1},
        "skipped": {"const": 0}
      }
    },
    "time_sec": {"type": "integer", "minimum": 30, "maximum": 600},
    "stem": {"type": "string", "minLength": 10},
    "stimulus_image": {"type": "string"},
    "passage": {"type": "string"},
    "options": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
    "answer_index": {"type": "integer", "minimum": 0, "maximum": 3},
    "hint": {"type": "string"},
    "solution": {"type": "string", "minLength": 1}
  }
}
